# Server-side switch; payment UI is enabled only when this configuration is valid.
RAZORPAY_ENABLED=false
# Use test for local/preview deployments. Live is reserved for production launch.
RAZORPAY_MODE=test
# Test keys must start with rzp_test_; live keys must start with rzp_live_.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret
RESEND_API_KEY=re_replace_with_your_resend_api_key
ORDER_NOTIFICATION_EMAIL=replace_with_the_email_that_receives_orders
# Set this after verifying your domain in Resend.
ORDER_NOTIFICATION_FROM=Twistify Arts <onboarding@resend.dev>
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/twistify-arts?retryWrites=true&w=majority
AUTH_SECRET=replace-with-a-long-random-secret
# Used only by `npm run seed:admin`; never expose these in the public site.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
